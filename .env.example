MONGODB_URI=mongodb://127.0.0.1:27017/spice-cart
SESSION_SECRET=replace-with-at-least-32-random-characters
CLIENT_ORIGIN=http://localhost:3000
API_PROXY_TARGET=http://127.0.0.1:5000
VITE_API_BASE_URL=
# Set to true to use the API from the local Vite development server.
VITE_API_ENABLED=false
# For Vercel production and preview deployments, set CLIENT_ORIGIN to the exact
# public app origin, for example https://spice-cart.vercel.app
PORT=5000
HOST=127.0.0.1

# Checkout is disabled by default. It also remains blocked until pending
# payment inventory reservations have an automated expiry/reconciliation flow.
CHECKOUT_ENABLED=false
ENABLE_LIVE_PAYMENTS=false
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STORE_NAME=
STORE_LEGAL_NAME=
STORE_ADDRESS=
STORE_CONTACT_EMAIL=
STORE_CONTACT_PHONE=
SHIPPING_POLICY_URL=
RETURNS_POLICY_URL=
PRIVACY_POLICY_URL=
TERMS_POLICY_URL=
SHIPPING_FEE_PAISE=
TAX_RATE_BPS=
# Comma-separated, manually verified MongoDB user ObjectIds allowed to manage
# catalog entries through the protected admin API.
ADMIN_USER_IDS=
